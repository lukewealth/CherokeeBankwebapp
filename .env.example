# ──────────────────────────────────────────────────────
# Cherokee Bank — Environment Variables
# Copy this file to .env.local and fill in your values
# ──────────────────────────────────────────────────────

# ── Database ──
DATABASE_URL=postgresql://user:password@localhost:5432/cherokee_bank

# ── Authentication (JWT) ──
JWT_SECRET=your-jwt-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=your-refresh-secret-at-least-32-characters
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── DeepSeek AI ──
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Redis (optional) ──
# REDIS_URL=redis://localhost:6379

# ── Email / SMTP (optional) ──
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# SMTP_FROM=noreply@cherokeebank.com

# ── Crypto Provider (optional) ──
# CRYPTO_PROVIDER_KEY=your-crypto-provider-api-key
# CRYPTO_PROVIDER_URL=https://api.crypto-provider.com

# ── Exchange Rate API (optional) ──
# EXCHANGE_RATE_API_KEY=your-exchange-rate-api-key

# ── Storage / S3 (optional) ──
# STORAGE_BUCKET=cherokee-bank-uploads
# STORAGE_REGION=us-east-1

# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Cherokee Bank

# ── Node Environment ──
NODE_ENV=development

# ── Admin Seed Credentials (optional) ──
# ADMIN_DEFAULT_EMAIL=admin@cherokeebank.com
# ADMIN_DEFAULT_PASSWORD=your-admin-password

# ── Cherokee ($CHERO) Token Peg Rate ──
CHERO_PEG_RATE_USD=1.0

# ── CORS (comma-separated origins) ──
CORS_ORIGINS=http://localhost:3000
